# Runtime
# Keep production when deployed behind HTTPS; use development for local HTTP testing.
NODE_ENV=production
PORT=5000
# Public URL used for sitemap.xml, robots.txt, Discord buttons and ad setup.
BASE_URL=https://free-game-deals.kiliotsu.eu
# Set to 1 when the app runs behind a reverse proxy (Nginx, Caddy, Cloudflare...).
TRUST_PROXY=1

# Discord
DISCORD_TOKEN=insert_token_discord
# Optional: forces owner scan notifications to this Discord user ID.
# OWNER_ID=123456789012345678
CLIENT_ID=1466415254203404433
CLIENT_SECRET=your_client_secret_id
# Must match the redirect URL configured in the Discord developer portal.
CALLBACK_URL=https://free-game-deals.kiliotsu.eu/auth/discord/callback
# Use a long random value (32+ characters).
SESSION_SECRET=replace_with_at_least_32_random_characters
# Bot invite permissions: ViewChannel + SendMessages + EmbedLinks + ReadMessageHistory + MentionEveryone
BOT_PERMISSIONS=216064

# Bot owner notifications. OWNER_ID is the Discord user ID that receives
# manual /scan notifications.
OWNER_ID=your_discord_user_id
# Optional: a private channel ID where owner notifications are also posted and
# the owner is mentioned. Useful if Discord DMs are filtered.
OWNER_LOG_CHANNEL_ID=

# Scrapers
STEAM_COUNTRY=US
STEAM_MAX_PAGES=5
GOG_MAX_PAGES=20
# Maximum number of store descriptions fetched per scan (safety limit).
STEAM_DESCRIPTION_LIMIT=40
GOG_DESCRIPTION_LIMIT=40

# Optional: override the SQLite database path.
# DB_PATH=./deals_memory.db

# Google AdSense
ADSENSE_CLIENT=ca-pub-7079129901617673
# Optional manual ad units. Leave empty to use AdSense Auto Ads only.
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_INFEED=
ADSENSE_SLOT_FOOTER=
